datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  action    String
  ipHash    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model Project {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String   @db.Text
  techStack      String[]
  githubUrl      String?
  liveUrl        String?
  imageUrl       String?
  featured       Boolean  @default(false)
  order          Int      @default(0)
  problemSolved  String?  @db.Text
  myContribution String?  @db.Text
  whyBuilt       String?  @db.Text
  features       String[] @default([])
  status         String?  @default("In Development")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([featured, order])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([tags])
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String
  level    Int    @default(50)
  order    Int    @default(0)

  @@index([category, order])
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  description String    @db.Text
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  order       Int       @default(0)

  @@index([startDate])
}

model Certification {
  id            String    @id @default(cuid())
  title         String
  issuer        String
  issueDate     DateTime?
  credentialUrl String?
  imageUrl      String?
  order         Int       @default(0)
}

model Education {
  id          String   @id @default(cuid())
  institution String
  degree      String
  department  String
  startYear   Int
  endYear     Int
  cgpa        String
  coursework  String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  category    String   // "Hackathon", "Academic", "Coding"
  description String   @db.Text
  year        Int?
  status      String?
  projectUrl  String?
  proofUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResumeDocument {
  id        String   @id @default(cuid())
  filename  String
  label     String   @default("Resume")
  mimeType  String   @default("application/pdf")
  fileSize  Int
  fileData  Bytes
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

model ProfileSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ProfileMedia {
  id        String   @id @default(cuid())
  type      String   @unique // e.g. "avatar"
  mimeType  String   @default("image/png")
  fileSize  Int
  fileData  Bytes
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt, read])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  device    String?
  browser   String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

model AnalyticsMetric {
  id     String   @id @default(cuid())
  path   String
  visits Int      @default(1)
  date   DateTime @db.Date

  @@unique([path, date])
  @@index([date])
}

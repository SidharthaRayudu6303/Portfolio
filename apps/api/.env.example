# ==========================================
# Backend (apps/api) Environment Variables
# ==========================================

NODE_ENV="production"
PORT=4000

# Permitted production frontend origin(s), comma-separated
FRONTEND_URL="https://sidhartha-portfolio.vercel.app"

# Neon PostgreSQL Dual-Connection URLs (Preserve existing connection strings)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Cryptographic Secrets (Minimum 32 characters; generated via openssl rand -base64 32)
JWT_SECRET="GENERATE_MINIMUM_32_CHAR_SECRET"
IP_SALT_SECRET="GENERATE_MINIMUM_32_CHAR_SECRET"
BACKUP_ENCRYPTION_KEY="GENERATE_MINIMUM_32_CHAR_SECRET"

# Initial Admin User Credentials (used only during seeding; never committed)
ADMIN_EMAIL="admin@sidhartha.dev"
ADMIN_PASSWORD="CHANGE_ME_TO_A_SECURE_PASSWORD"

# Optional: Google Gemini API Key for AI Assistant (Free Tier, 0 cost; if empty, uses verified offline engine)
GEMINI_API_KEY=""

# Optional: SMTP Configuration for outbound contact notifications (free via Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
CONTACT_RECIPIENT_EMAIL=""


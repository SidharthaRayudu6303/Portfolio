# ==========================================
# Frontend (apps/web) Environment Variables
# ==========================================

# Public URL of the deployed frontend
NEXT_PUBLIC_SITE_URL="https://sidhartha-portfolio.vercel.app"

# Internal URL to the deployed backend API (used by Next.js BFF server-side routes)
# In development: http://localhost:4000/api/v1
# In production: https://<your-backend-service>.onrender.com/api/v1
BACKEND_API_URL="https://sidhartha-portfolio-api.onrender.com/api/v1"


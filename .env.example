# ==========================================
# Frontend (apps/web) Environment Variables
# ==========================================
NEXT_PUBLIC_SITE_URL="https://sidhartha-portfolio.vercel.app"
INTERNAL_API_URL="https://sidhartha-portfolio-api.vercel.app"
CSRF_SECRET="GENERATE_MINIMUM_32_CHAR_BASE64_SECRET"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"

# ==========================================
# Backend (apps/api) Environment Variables
# ==========================================
NODE_ENV="production"
PORT=4000
FRONTEND_URL="https://sidhartha-portfolio.vercel.app"

# Neon PostgreSQL Dual-Connection URLs
DATABASE_URL="postgresql://user:pass@ep-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-direct.region.neon.tech/neondb?sslmode=require"

# Cryptography & Security Secrets (Generate via: openssl rand -base64 32)
JWT_SECRET="GENERATE_MINIMUM_32_CHAR_BASE64_SECRET"
IP_SALT_SECRET="GENERATE_MINIMUM_32_CHAR_BASE64_SECRET"
BACKUP_ENCRYPTION_KEY="GENERATE_MINIMUM_32_CHAR_BASE64_SECRET"

# Initial Admin Seeding (CLI only)
ADMIN_EMAIL="admin@sidhartha.dev"
ADMIN_PASSWORD="StrongPassword123!@#"

# Google AI Studio (Free Tier)
GEMINI_API_KEY=""

# Email Notifications (Gmail SMTP + App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
NOTIFICATION_EMAIL="your-email@gmail.com"

# Cloudinary Storage (Free Tier)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_key"
CLOUDINARY_API_SECRET="your_secret"
